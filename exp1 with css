<!DOCTYPE html>
<html>
<head>
    <title>Experiment 1</title>

    <style>
        body {
            background: linear-gradient(to right, #d16ba5, #c777b9, #ba83ca);
            font-family: "Segoe UI", Arial, sans-serif;
            margin: 0;
            padding: 0;
        }

        h1 {
            color: white;
            text-shadow: 2px 2px 5px #4b004b;
            font-size: 36px;
            margin-top: 20px;
        }

        p {
            font-size: 17px;
            color: white;
        }

        a {
            text-decoration: none;
            background: white;
            color: purple;
            padding: 12px 25px;
            border-radius: 25px;
            font-weight: bold;
            box-shadow: 0px 4px 10px gray;
            transition: 0.3s;
        }

        a:hover {
            background: purple;
            color: white;
        }

        img {
            border-radius: 15px;
            margin: 15px;
            border: 4px solid white;
            box-shadow: 0px 0px 15px black;
            transition: transform 0.3s;
        }

        img:hover {
            transform: scale(1.05);
        }

        .box {
            background-color: white;
            width: 420px;
            margin: auto;
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0px 10px 25px rgba(0,0,0,0.3);
        }

        h3 {
            color: purple;
            font-size: 22px;
        }

        input[type="number"] {
            width: 100%;
            padding: 10px;
            border-radius: 8px;
            border: 1px solid #aaa;
        }

        button {
            width: 100%;
            padding: 12px;
            background: linear-gradient(to right, purple, darkmagenta);
            color: white;
            font-size: 17px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: 0.3s;
        }

        button:hover {
            opacity: 0.9;
            transform: translateY(-2px);
        }

        table {
            width: 100%;
            font-size: 16px;
        }

        table tr:hover {
            background-color: #f3e5f5;
        }

        footer {
            background-color: #4b004b;
            color: white;
            padding: 12px;
            margin-top: 30px;
        }
    </style>
</head>

<body>

    <h1 align="center">Online Fitness & Health Tracker</h1>

    <p align="center">
        <i>“The journey of a thousand miles begins with a single step.”</i>
    </p>

    <br>

    <p align="center">
        <a href="https://www.google.com/fit/">Explore Google Fit</a>
    </p>

    <br>

    <center>
        <img src="C:\Users\sivas\OneDrive\Desktop\FRONTEND\HTML\photos\image 1.jpg" width="300" height="300">
        <img src="C:\Users\sivas\OneDrive\Desktop\FRONTEND\HTML\photos\image2.avif" width="300" height="300">
        <img src="C:\Users\sivas\OneDrive\Desktop\FRONTEND\HTML\photos\image 3.jpg" width="300" height="300">
    </center>

    <br><br>

    <div class="box">
        <h3 align="center">BMI Calculator</h3>

        <form>
            <label>Height (in cm)</label><br>
            <input type="number"><br><br>

            <label>Weight (in kg)</label><br>
            <input type="number"><br><br>

            <button type="submit">Calculate</button>
        </form>

        <p align="center">BMI = Weight (kg) / Height² (m)</p>
    </div>

    <br><br>

    <div class="box">
        <h3 align="center">Daily Fitness Checklist</h3>

        <table cellpadding="10">
            <tr>
                <td>Drink 8 Glasses of Water</td>
                <td align="center"><input type="checkbox"></td>
            </tr>
            <tr>
                <td>Walk 10,000 Steps</td>
                <td align="center"><input type="checkbox"></td>
            </tr>
            <tr>
                <td>30 Minutes Workout</td>
                <td align="center"><input type="checkbox"></td>
            </tr>
            <tr>
                <td>Sleep 8 Hours</td>
                <td align="center"><input type="checkbox"></td>
            </tr>
        </table>
    </div>

    <footer>
        <p align="right">Copyright © <b>Sivasankari</b></p>
    </footer>

</body>
</html>
