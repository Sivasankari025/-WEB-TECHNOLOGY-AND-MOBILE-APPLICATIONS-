    <!-- BMI Section -->
    <div style="background-color: white; width: 400px; margin: auto; padding: 20px; border: 1px solid #ccc;">
        <h3 align="center">BMI Calculator</h3>

        <form>
            <label>Height (in cm)</label><br>
            <input type="number" style="width: 100%; padding: 8px;"><br><br>

            <label>Weight (in kg)</label><br>
            <input type="number" style="width: 100%; padding: 8px;"><br><br>

            <button type="submit" style="width: 100%; padding: 10px;">
                Calculate
            </button>
        </form>

        <p align="center">
            BMI = Weight (kg) / Height² (m)
        </p>
    </div>

    <br><br>

    <!-- Daily Fitness Checklist -->
    <div style="background-color: white; width: 420px; margin: auto; padding: 10px;">
        <h3 align="center">Daily Fitness Checklist</h3>

